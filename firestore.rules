rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only the Ghubor admin account (signed in via Firebase Auth from /admin)
    // may write to storefront-management data.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ghuborsupport@gmail.com';
    }

    // ── Storefront content: public read, admin-only write ──────────────────
    match /cms-products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cms-categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cms-blog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cms-coupons/{id} {
      // Public read so the cart/checkout can validate a typed-in code
      // without requiring the shopper to sign in.
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Internal ops data: admin only ───────────────────────────────────────
    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    // ── Orders: guests can place an order; only the owner or admin can read ─
    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
      allow update, delete: if isAdmin();
    }

    // ── Customer profiles: only the owning signed-in user ───────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Anonymous analytics counters: anyone can increment, only admin reads ─
    match /analytics/{id} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
